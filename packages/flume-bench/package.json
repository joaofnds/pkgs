{
	"name": "@joaofnds/flume-bench",
	"version": "0.0.0",
	"private": true,
	"license": "Apache-2.0",
	"author": "joaofnds <joaofnds@joaofnds.com>",
	"repository": {
		"url": "https://github.com/joaofnds/pkgs.git",
		"type": "git",
		"directory": "packages/flume-bench"
	},
	"scripts": {
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"bench": "docker compose up -d && NODE_OPTIONS=--expose-gc tsx benchmark/throughput.bench.ts; docker compose down",
		"bench:sat": "docker compose up -d && tsx benchmark/saturation.ts; docker compose down",
		"bench:profile": "docker compose up -d && tsx benchmark/profile.ts; docker compose down"
	},
	"devDependencies": {
		"@joaofnds/flume": "workspace:^",
		"@joaofnds/flume-nats": "workspace:^",
		"@joaofnds/flume-redis": "workspace:^",
		"@joaofnds/throughput": "workspace:^",
		"@nats-io/jetstream": "^3.4.0",
		"@nats-io/nats-core": "^3.4.0",
		"@nats-io/transport-node": "^3.4.0",
		"@types/node": "^24.13.2",
		"bullmq": "^5.78.1",
		"ioredis": "^5.11.1",
		"mitata": "^1.0.34",
		"redis": "^6.2.1",
		"tsx": "^4.23.12",
		"typescript": "^6.0.3"
	}
}
